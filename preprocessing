import cv2
import numpy as np


def preprocess_image(image_path):
   # Đọc ảnh
    image = cv2.imread(image_path)
    if image is None:
        raise FileNotFoundError(f"Không thể đọc ảnh từ đường dẫn: {image_path}")
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # Loại bỏ background (dùng màu trắng làm nền)
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    lower = np.array([0, 0, 200])
    upper = np.array([180, 50, 255])
    mask = cv2.inRange(hsv, lower, upper)
    mask_inv = cv2.bitwise_not(mask)
    foreground = cv2.bitwise_and(image_rgb, image_rgb, mask=mask_inv)

    # Làm rõ vùng fruit 
    lab = cv2.cvtColor(foreground, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    l_eq = cv2.equalizeHist(l)
    lab_eq = cv2.merge((l_eq, a, b))
    enhanced = cv2.cvtColor(lab_eq, cv2.COLOR_LAB2RGB)

    # tìm contour 
    gray = cv2.cvtColor(enhanced, cv2.COLOR_RGB2GRAY)
    blur = cv2.GaussianBlur(gray, (5, 5), 0)
    _, thresh = cv2.threshold(blur, 10, 255, cv2.THRESH_BINARY)
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if contours:
        c = max(contours, key=cv2.contourArea)
        x, y, w, h = cv2.boundingRect(c)
        cropped = enhanced[y:y+h, x:x+w]
    else:
        cropped = enhanced  

    # Resize và chuẩn hóa pixel [0,1]
    resized = cv2.resize(cropped, (100, 100))
    normalized = resized.astype("float32") / 255.0

    # chuyển thành mảng đầu vào cho model (batch_size, 100, 100, 3)
    input_tensor = np.expand_dims(normalized, axis=0)

    return input_tensor
